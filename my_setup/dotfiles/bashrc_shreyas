export ARMLMD_LICENSE_FILE=7117@license-wan-20-sd.qualcomm.com
export ARMLM_ONDEMAND_ACTIVATION=HWSKT-PRE0@http://license-pdlm-1-encnaa.qualcomm.com:7070
#export DISPLAY=:10.0
export DISPLAY=localhost:11.0
